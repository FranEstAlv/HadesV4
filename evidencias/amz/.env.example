# Configuración de la API Leviatan CHK

# Flask
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=leviatan_api
MYSQL_PASSWORD=secure_password_here
MYSQL_DB=leviatan_chk

# API
API_VERSION=1.0
API_SECRET_KEY=your_secret_key_here_change_this

# Seguridad
ENABLE_PROXY_CHECK=True
ENABLE_LOGGING=True
MAX_REQUESTS_PER_HOUR=100

# Amazon
AMAZON_BASE_URL=https://www.amazon.com
AMAZON_WALLET_URL=https://www.amazon.com/gp/wallet
AMAZON_PAYMENT_URL=https://www.amazon.com/gp/buy/paymethod/handlers/display.html

# Logging
LOG_LEVEL=INFO
LOG_FILE=api.log
