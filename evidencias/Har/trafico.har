          "content": {
            "size": 7389,
            "mimeType": "text/css",
            "text": ".card-list {\r\n}\r\n\r\n    /*command row holder*/\r\n    .card-list .header-row-holder {\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n        .card-list .header-row-holder.wide {\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .card-list .header-row-holder.row {\r\n            /*margin-left: 0;\r\n            margin-right: 0;*/\r\n        }\r\n\r\n        /*generic command row class*/\r\n        .card-list .header-row-holder .header-row {\r\n            padding: 5px;\r\n        }\r\n\r\n        /*command row*/\r\n        .card-list .header-row-holder .command-row {\r\n            position: relative;\r\n            background-color: #ccc;\r\n        }\r\n\r\n        /*.card-list .header-row-holder .command-row .row > div {\r\n                line-height: 34px;\r\n            }*/\r\n\r\n        /*.card-list .header-row-holder .command-row .row > div * {\r\n                    vertical-align: middle;\r\n                }*/\r\n\r\n        /*info row*/\r\n        .card-list .header-row-holder .info-row-wrapper {\r\n            background-color: #ddd;\r\n        }\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    /*.card-list .header-row-holder .header-row-item:first-of-type .header-row {\r\n        border-radius: 6px 6px 0 0;\r\n    }\r\n\r\n    .card-list .header-row-holder .header-row-item:last-of-type .header-row {\r\n        border-radius: 0 0 6px 6px;\r\n    }\r\n\r\n    .card-list .header-row-holder .header-row-item:only-of-type .header-row {\r\n        border-radius: 6px;\r\n    }*/\r\n\r\n    .card-list .card-container > div {\r\n        /*padding: 5px;*/\r\n    }\r\n\r\n    .card-list .empty {\r\n        padding: 15px;\r\n    }\r\n\r\n    .card-list .card {\r\n        position: relative;\r\n        margin-bottom: 10px;\r\n        background-color: #edfaff;\r\n        /*border: 2px solid #ced7dd;*/\r\n        border: 1px solid #daeaf1;\r\n        /*border-radius: 6px;*/\r\n        transition: background-color 0.2s ease-in-out;\r\n    }\r\n\r\n        .card-list .card.narrow,\r\n        .card-list .card.archived.narrow {\r\n            margin-bottom: 1px;\r\n            border: none;\r\n            /*border-bottom: 1px solid #aed9ff;*/\r\n        }\r\n\r\n        .card-list .card.wide {\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n\r\n        .card-list .card.selected,\r\n        .card-list .card.archived.selected {\r\n            background-color: #b8f8d0;\r\n        }\r\n\r\n            .card-list .card.selected:hover,\r\n            .card-list .card.archived.selected:hover {\r\n                background-color: #90f8b7;\r\n            }\r\n\r\n        .card-list .card.drag-over-top {\r\n            border-top: 3px solid #52cbff;\r\n            margin-top: 13px;\r\n            /*border-radius: 0px;*/\r\n        }\r\n\r\n        .card-list .card.drag-over-bottom {\r\n            border-bottom: 3px solid #52cbff;\r\n            margin-bottom: 13px;\r\n            /*border-radius: 0px;*/\r\n        }\r\n\r\n        .card-list .card .rlvDrag {\r\n            background-image: url('/Images/24x24/drag.png');\r\n            background-repeat: no-repeat;\r\n            border: none;\r\n            width: 24px;\r\n            height: 24px;\r\n            vertical-align: middle;\r\n            background-color: transparent;\r\n            background-position: 50% 50%;\r\n        }\r\n\r\n    .card-list .checkbox-column {\r\n        display: table-cell;\r\n        vertical-align: top;\r\n        width: 1px;\r\n    }\r\n\r\n        .card-list .checkbox-column .select {\r\n            padding-left: 5px;\r\n            position: static;\r\n            margin-right: 0;\r\n        }\r\n\r\n            .card-list .checkbox-column .select input {\r\n                position: static;\r\n                margin-left: 0;\r\n            }\r\n\r\n    .card-list .command-row .checkbox-column .select {\r\n        padding-left: 0;\r\n    }\r\n\r\n/*.card-list .checkbox-column:empty{\r\n            display: none;\r\n        }*/\r\n\r\n.rlvDraggedItem .rlvI {\r\n    padding: 15px;\r\n}\r\n\r\n    .rlvDraggedItem .rlvI input.rlvDrag {\r\n        background-image: url('/Images/24x24/drag.png') !important;\r\n        background-repeat: no-repeat;\r\n        border: none;\r\n        width: 24px;\r\n        height: 24px;\r\n    }\r\n\r\n.card-list .command-row > .select,\r\n.card-list .card > .select {\r\n    z-index: 10;\r\n    /*position: absolute;*/\r\n    top: -15px;\r\n    left: -4px;\r\n    line-height: normal;\r\n}\r\n\r\n.card-list .card .header {\r\n    background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n\r\n.card-list .card .body {\r\n    padding-right: 5px;\r\n}\r\n\r\n    .card-list .card .body.pad-right,\r\n    .card-list .header-row.pad-right {\r\n        padding-right: 54px;\r\n    }\r\n\r\n    .card-list .card .body.pad-bottom {\r\n        padding-bottom: 54px;\r\n    }\r\n\r\n.card-list .card .header,\r\n.card-list .card .body {\r\n    padding: 2px 5px;\r\n}\r\n\r\n    .card-list .card .header .header-item {\r\n        margin: 0 5px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n\r\n.card-list .card a.header-action {\r\n    text-decoration: none;\r\n}\r\n\r\n.card-list .card.archived {\r\n    border: 1px solid #f2dfea;\r\n    background-color: #fff0f9;\r\n}\r\n\r\n    .card-list .card.archived:hover {\r\n        background-color: #ffe0f2;\r\n    }\r\n\r\n.card-list .card.added {\r\n    border: 1px solid #f2dfea;\r\n    background-color: #b8f8d0;\r\n}\r\n\r\n    .card-list .card.added:hover {\r\n        background-color: #90f8b7;\r\n    }\r\n\r\n.card-list .card:hover {\r\n    background-color: #ceecf9;\r\n}\r\n\r\n.card-list .card .action {\r\n    opacity: 1;\r\n    background-color: rgba(255, 255, 255, 0.75);\r\n    cursor: default;\r\n    transition: background-color 0.2s ease-in-out;\r\n}\r\n\r\n    .card-list .card .action.right {\r\n        display: table-cell;\r\n        padding: 5px 10px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    /*.card-list .card .header-action + .body > .action.right {\r\n            border-radius: 0 0 6px 0;\r\n        }*/\r\n\r\n    .card-list .card .action.bottom {\r\n        /*position: absolute;*/\r\n        /*bottom: 0;\r\n        left: 0;\r\n        width: 100%;*/\r\n        /*border-radius: 0 0 6px 6px;*/\r\n        /*line-height: 32px;*/\r\n        padding: 5px 0;\r\n    }\r\n\r\n    .inline-action {\r\n        display: inline-block!important;\r\n    }\r\n\r\n    .card-list .card .action.right > *:not(.dropdown-menu) {\r\n        display: block;\r\n        margin: 5px 0;\r\n    }\r\n\r\n    .card-list .card .action.bottom > *:not(.dropdown-menu) {\r\n        display: inline-block;\r\n        margin: 0 5px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    /*for radtoolbar inside action bar*/\r\n    .card-list .card .action .rtbOuter {\r\n        background: none !important;\r\n        padding: 0px;\r\n    }\r\n\r\n    .card-list .card .action .rtbItem a {\r\n        background: none !important;\r\n        color: #000 !important;\r\n    }\r\n\r\n    .card-list .card .action .rtbItem:hover {\r\n        background: rgba(0,0,0,0.1);\r\n    }\r\n\r\n.card-list .info-row-wrapper.detached {\r\n    position: fixed;\r\n    box-shadow: 0px 1px 10px #333;\r\n    z-index: 10000;\r\n    /*border-radius: 0 0 6px 6px;*/\r\n}\r\n\r\n.card-list .row,\r\n.card-list.row {\r\n    margin-left: -5px;\r\n    margin-right: -5px;\r\n}\r\n\r\n.card-list div[class*=col-] {\r\n    padding-left: 5px;\r\n    padding-right: 5px;\r\n}\r\n\r\n.card-list .RadDataPager {\r\n    margin-top: 5px;\r\n}\r\n\r\n@media screen and (max-width: 992px) {\r\n    .card-list .info-row-wrapper.detached {\r\n        position: static;\r\n        box-shadow: none;\r\n        z-index: 0;\r\n        margin-top: 5px;\r\n    }\r\n}\r\n\r\n@media screen and (max-width: 480px) {\r\n    .RadDataPager.miles-data-pager .rdpWrap:nth-child(2) {\r\n        float: none;\r\n    }\r\n\r\n    /*.RadDataPager .rdpWrap.rdpNumPart {\r\n        display: none !important;\r\n    }*/\r\n}\r\n"
