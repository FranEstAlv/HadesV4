# GenCookie Hades - Variables de entorno
# Copia este archivo a .env y rellena con tus propios valores.
# NUNCA subas el .env real a control de versiones.

# Token de tu bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuv

# IDs de super admins de Telegram (separados por coma)
SUPER_ADMINS=1234567890

# ---------------------------------------------------------------------------
# Proxies IPRoyal (residencial)
# ---------------------------------------------------------------------------
IPROYAL_USERNAME=tu_usuario_iproyal
IPROYAL_PASSWORD_BASE=tu_password_iproyal
IPROYAL_EXTRA_ARGS=_streaming-1
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=11245
IPROYAL_PROTOCOL=http

# Rotatorio random (string completa del .env)
IPROYAL_ROTATORY_URL=http://usuario:password@geo.iproyal.com:11245

# Sticky Mexico (string completa para el gate)
IPROYAL_STICKY_MX_URL=http://usuario:password_country-mx_session-xxxx_lifetime-10m@geo.iproyal.com:12321

IPROYAL_STICKY_COUNTRIES=mx,us
IPROYAL_STICKY_LIFETIME=2m
IPROYAL_ROTATING_COUNTRIES=mx,us
IPROYAL_POOL_COUNTRIES=mx,us,ca,br,es,it
IPROYAL_POOL_STICKY_LIFETIME=2m

# ---------------------------------------------------------------------------
# Gateway GHOST — PayPal Guest Checkout
# ---------------------------------------------------------------------------
PAYPAL_GUEST_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_GUEST_CURRENCY=MXN
PAYPAL_GUEST_AMOUNT=5.00
GHOST_CHARGE_LABEL=$5 MXN
GHOST_GLOBAL_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Gateway NMI $1.00 (DonorPerfect WebLink)
# ---------------------------------------------------------------------------
NMI_DEFAULT_PROXY=
NMI_AMOUNT=1.00
NMI_GLOBAL_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# SQLite local (usa el bot por defecto)
# DATABASE_URL=postgresql://gencookie_bot@localhost:5432/gencookie

# ---------------------------------------------------------------------------
# EmailApi polling (TempMail local)
# ---------------------------------------------------------------------------
TEMPMAIL_API=http://127.0.0.1:3000
EMAILAPI_DB_PATH=/ruta/al/proyecto/EmailApi/emails.db
EMAILAPI_SMTP_HOST=0.0.0.0
EMAILAPI_SMTP_PORT=1025
EMAILAPI_API_HOST=127.0.0.1
EMAILAPI_API_PORT=3000
EMAILAPI_EXPIRY_MINUTES=30
EMAILAPI_CLEANUP_INTERVAL_S=300
EMAILAPI_DOMAINS=tudominio.cyou
EMAILAPI_DOMAIN_WEIGHTS=tudominio.cyou:1
TEMPMAIL_POLL_INTERVAL=3
EMAILAPI_RATE_LIMIT_REQUESTS=30
EMAILAPI_RATE_LIMIT_WINDOW_S=60

# ---------------------------------------------------------------------------
# Solucionadores de captcha
# ---------------------------------------------------------------------------
CAPSOLVER_API_KEY=tu_api_key_capsolver
ANTICAPTCHA_API_KEY=tu_api_key_anticaptcha
TWO_CAPTCHA_API_KEY=tu_api_key_2captcha
V3_SOLVER=2captcha

# ---------------------------------------------------------------------------
# Proveedor de SMS (HeroSMS) para CVF de Amazon
# ---------------------------------------------------------------------------
HEROSMS_API_KEY=tu_api_key_herosms

# ---------------------------------------------------------------------------
# Gate Krispy Kreme MX
# ---------------------------------------------------------------------------
KRISPY_ACCOUNTS_FILE=data/gates/krispy_accounts.txt
KRISPY_COUNTRY=mx
KRISPY_LIFETIME=10m
KRISPY_IMPERSONATE=chrome150
KRISPY_TIMEOUT=30
KRISPY_CONCURRENCY=2
KRISPY_MAX_CARDS_PER_ACCOUNT=3
ATLAS_2CAPTCHA_KEY=tu_api_key_2captcha

# ---------------------------------------------------------------------------
# Webhook (alternativa a polling)
# ---------------------------------------------------------------------------
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
