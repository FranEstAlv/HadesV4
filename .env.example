# GenCookie Hades - Variables de entorno
# Copia este archivo a .env y rellena con tus propios valores.
# NUNCA subas el .env real a control de versiones.

# Token de tu bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuv

# IDs de super admins de Telegram (separados por coma)
# NOTA: bot/config.py lee SUPER_ADMIN_IDS (plural correcto).
# .env actual usa SUPER_ADMINS por legado — se soportan ambas, pero usa esta.
SUPER_ADMIN_IDS=1234567890,0987654321
SUPER_ADMINS=1234567890
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Bot general / costos (bot/config.py)
# ---------------------------------------------------------------------------
DEFAULT_COUNTRY=US
GENERATION_DELAY=5
COOKIE_COST=10
VERIFICATION_COST=5
VIP_COST=1000
MASS_CREDIT_COST=5
RFC_CREDIT_COST=15

# Costos gates Telcel (provisionales — Fernando debe definir precio final)
TELCEL_SALDO_COST=5
TELCEL_MEGAS_COST=5
TELCEL_FACTURA_COST=10
TELCEL_RECARGA_COST=10
TELCEL_COOLDOWN_S=60
TELCEL_PROXY=
# Secrets gates Telcel (Fase 1: antes hardcodeados en bot/services/telcel/gates.py)
TELCEL_DECRYPT_PASSWORD=
TELCEL_ENCRYPT_PASSWORD=
TELCEL_T1_BEARER=
TELCEL_MITELCEL_BEARER=

# Amazon gate (bot/config.py)
AMAZON_IMPERSONATE=chrome150
AMAZON_BROWSER_VERSION=150
AMAZON_BROWSER_FALLBACK=1
AMAZON_BROWSER_SESSION_TTL_S=600
AMAZON_ACCOUNT_HOLDER_NAME=OLIMPO MEDINA

# WAF Solver (bot/config.py — claves por defecto en código, mejor ponerlas aquí)
AES_KEY=6f71a512b1e035eaab53d8be73120d3fb68a0ca346b9560aab3e5cdf753d5e98
C_SCRYPT=h72f957df656e80ba55f5d8ce2e8e7ccb59687dba3bfb273d54b08a261b2f3002
C_SHA256=h7b0c470f0cfe3a80a9e26526ad185f484f6817d0832712a4a37a908786a6a67f
C_BANDWIDTH=ha9faaffd31b4d5ede2a2e19d2d7fd525f66fee61911511960dcbb52d3c48ce25

# ---------------------------------------------------------------------------
# Proxies IPRoyal (residencial)
# ---------------------------------------------------------------------------
IPROYAL_USERNAME=tu_usuario_iproyal
IPROYAL_PASSWORD_BASE=tu_password_iproyal
IPROYAL_EXTRA_ARGS=
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=11245
IPROYAL_PROTOCOL=http

# Rotatorio random (string completa del .env)
IPROYAL_ROTATORY_URL=http://usuario:password@geo.iproyal.com:11245

# Sticky Mexico (string completa para el gate)
IPROYAL_STICKY_MX_URL=http://usuario:password_country-mx_session-xxxx_lifetime-10m@geo.iproyal.com:12321

IPROYAL_STICKY_COUNTRIES=mx,us
IPROYAL_STICKY_LIFETIME=2m
IPROYAL_ROTATING_COUNTRIES=mx,us
IPROYAL_POOL_COUNTRIES=mx,us,ca,br,es,it
IPROYAL_POOL_STICKY_LIFETIME=2m

# ---------------------------------------------------------------------------
# Gateway GHOST — PayPal Guest Checkout
# ---------------------------------------------------------------------------
PAYPAL_GUEST_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_GUEST_CURRENCY=MXN
PAYPAL_GUEST_AMOUNT=5.00
GHOST_CHARGE_LABEL=$5 MXN
GHOST_GLOBAL_CONCURRENCY=3

# ---------------------------------------------------------------------------
